{
  "name": "hyperframes-block-editor",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "player:build": "node scripts/build-player.mjs",
    "server:tts": "tsx server/tts-server.ts",
    "predev": "npm run player:build",
    "prebuild": "npm run player:build",
    "electron:bundle": "esbuild electron/runtime.ts --bundle --platform=node --format=esm --outfile=electron/runtime.mjs && esbuild electron/main.ts --bundle --platform=node --format=esm --external:electron --external:@ffmpeg-installer/ffmpeg --outfile=electron/main.mjs",
    "electron": "concurrently -k \"vite --host 127.0.0.1 --port 5178 --strictPort\" \"wait-on http://127.0.0.1:5178 && npm run electron:bundle && electron electron/main.mjs\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test:delivery": "tsx scripts/test-delivery-package.ts",
    "test:workflow": "tsx scripts/test-production-workflow.ts",
    "test:voiceover": "tsx scripts/test-batch-voiceover.ts",
    "test:health": "tsx scripts/test-project-health.ts",
    "test:release": "tsx scripts/test-release-candidate.ts",
    "test:render": "tsx scripts/test-release-render.ts",
    "test:render-integration": "tsx scripts/test-electron-release-render.ts",
