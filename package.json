    "test:frontend-chunks": "tsx scripts/test-frontend-chunks.ts",
    "test:post-publish": "tsx scripts/test-post-publish-feedback.ts",
    "test:post-publish-experiment": "tsx scripts/test-post-publish-experiment.ts",
    "test:director-learning": "tsx scripts/test-director-learning-library.ts",
    "test:learning-brief": "tsx scripts/test-learning-brief-proposal.ts",
    "test:learning-brief-ui": "node scripts/test-learning-brief-proposal-ui.mjs",
    "test:project-archive": "tsx scripts/test-project-archive.ts",
