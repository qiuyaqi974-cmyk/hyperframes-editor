{
  "name": "hyperframes-block-editor",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "player:build": "node scripts/build-player.mjs",
    "server:tts": "tsx server/tts-server.ts",
    "predev": "npm run player:build",
    "prebuild": "npm run player:build",
    "electron:bundle": "esbuild electron/runtime.ts --bundle --platform=node --format=esm --outfile=electron/runtime.mjs",
    "electron": "concurrently -k \"vite --host 127.0.0.1 --port 5178 --strictPort\" \"wait-on http://127.0.0.1:5178 && npm run electron:bundle && electron --require tsx/cjs electron/main.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate:artifact": "test -f dist/index.html"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.11.17",
    "playwright-core": "^1.55.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^9.1.0"
  }
}
