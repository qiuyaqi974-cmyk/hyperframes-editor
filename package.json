    "test:publication-audit-diff": "tsx scripts/test-publication-audit-diff.ts",
    "test:publication-audit-diff-verifier": "tsx scripts/test-publication-audit-diff-verifier.ts",
    "test:publication-audit-ui": "node scripts/test-publication-audit-report-ui.mjs",
    "test:platform-adapter": "tsx scripts/test-platform-data-adapter.ts",
    "test:platform-adapter-ui": "node scripts/test-platform-data-adapter-ui.mjs",
    "test:post-publish-batch": "tsx scripts/test-post-publish-batch-session.ts",
    "test:scene-review": "tsx scripts/test-scene-review.ts",
    "preview": "vite preview",
    "validate:artifact": "test -f dist/index.html"
