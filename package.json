    "test:story-assembly": "tsx scripts/test-source-story-assembly.ts",
    "test:story-preview": "tsx scripts/test-source-story-preview.ts",
    "test:story-versions": "tsx scripts/test-source-story-versions.ts",
    "test:story-handoff": "tsx scripts/test-source-story-handoff.ts",
    "test:story-handoff-export": "tsx scripts/test-story-handoff-export.ts",
    "test:story-roundtrip": "tsx scripts/test-source-story-roundtrip.ts",
