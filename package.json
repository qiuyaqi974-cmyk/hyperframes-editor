    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.5",
    "electron": "^43.4.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.12",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^9.1.0"
  }
